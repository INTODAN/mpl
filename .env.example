# The lobby's own settings, which its local server (cmd/lobby) and its Lambda
# function (cmd/lobby-lambda) read; see README.md, "Running the lobby". Every
# name starts with LOBBY_. Local development only: replace every value before
# deploying, and never ship them in a client artifact. In the Island Battles
# monorepo, the root .env.example holds the same settings for scripts/dev.sh.

# The lobby's own PostgreSQL database, which the migrate command (cmd/migrate)
# and the local server, as it starts, migrate. In the Island Battles
# monorepo, scripts/dev.sh creates it beside the game's.
LOBBY_DATABASE_URL=postgres://lobby:lobby@localhost:5432/lobby?sslmode=disable
# Optional pool limits: 2 connections on Lambda, 10 on the local server.
# LOBBY_DATABASE_MAX_OPEN_CONNECTIONS=10
# LOBBY_DATABASE_MAX_IDLE_CONNECTIONS=2
# LOBBY_DATABASE_CONNECTION_MAX_IDLE_TIME=1m

# The local server's address; :8890 when unset.
LOBBY_HTTP_ADDR=:8890
# Where players and games reach the lobby, an origin without a path. It is the
# iss of the lobby's player tokens, so a game that verifies them uses it as
# the lobby's URL.
LOBBY_PUBLIC_URL=http://localhost:8890

# Centrifugo: the WebSocket URL that connection tokens send players to, and
# its HTTP API, which the lobby pushes each committed change to.
LOBBY_CENTRIFUGO_PUBLIC_URL=ws://localhost:8000/connection/websocket
LOBBY_CENTRIFUGO_API_URL=http://localhost:8000/api
LOBBY_CENTRIFUGO_API_KEY=local-development-centrifugo-api-key-change-me
# Signs the Centrifugo connection tokens; Centrifugo's
# client.token.hmac_secret_key.
LOBBY_CONNECTION_TOKEN_HMAC_SECRET=local-development-connection-token-secret-change-me
# The X-Lobby-Proxy-Secret header of Centrifugo's subscribe and refresh proxy
# calls; Centrifugo's CENTRIFUGO_VAR_LOBBY_PROXY_SECRET.
LOBBY_PROXY_SECRET=local-development-lobby-proxy-secret-change-me

# Optional: the games' sites whose own lobby UI, such as a game's web client,
# calls the player API from another origin, separated by commas. Each origin
# gets CORS answers on /lobby/v1/; unset, no other site may call it.
# LOBBY_ALLOWED_ORIGINS=https://game.example.org,http://localhost:3000

# The player token keys, kid:seed pairs separated by commas, where seed is an
# Ed25519 seed of 32 bytes in base64url without padding. The first key signs;
# all are published at /lobby/v1/jwks.json. Make a new seed with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
LOBBY_PLAYER_TOKEN_KEYS=local:bG9jYWwtZGV2ZWxvcG1lbnQta2V5LWNoYW5nZS1tZSE
# Optional: how long a player token lasts, from 1m to the default 15m.
# LOBBY_PLAYER_TOKEN_LIFETIME=15m

# The games, a JSON array; see README.md, "Binding a game over HTTP". Each
# game's shared secret is in the variable its secret_env names, at least 32
# bytes.
# A game on its own site gives the lobby page absolute URLs there, on its
# frontend's origin: https, or http on localhost.
LOBBY_GAMES=[{"key": "example-game", "name": "Example Game", "hooks_url": "http://localhost:9000/lobby-hooks", "secret_env": "LOBBY_GAME_SECRET_EXAMPLE_GAME", "frontend": {"origin": "http://localhost:9000", "result_url": "http://localhost:9000/example-game/{lobby_id}/result"}}]
LOBBY_GAME_SECRET_EXAMPLE_GAME=local-development-example-game-secret-change-me

# Optional retention settings; see README.md, "Deleting old data". Unset, each
# keeps its default.
# LOBBY_RETENTION_IDLE_PERIOD=1h
# LOBBY_RETENTION_MAXIMUM_AGE=24h
# LOBBY_RETENTION_CREATE_REQUESTS=24h
# LOBBY_RETENTION_EXPIRED_SESSIONS=1h
# LOBBY_RETENTION_BATCH_SIZE=50
# LOBBY_RETENTION_PASS_INTERVAL=1m
