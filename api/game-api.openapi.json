{
  "components": {
    "schemas": {
      "AuthorizeWatchRequest": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/AuthorizeWatchRequest.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "player_id": {
            "description": "The player who asks to watch, as the lobby names them.",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "player_id"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/ErrorModel.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "GameProblem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "unauthenticated",
              "not_found",
              "permission_denied",
              "watcher_kicked",
              "invalid_input",
              "unavailable",
              "internal_error"
            ],
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "code"
        ],
        "type": "object"
      },
      "Lobby": {
        "additionalProperties": false,
        "properties": {
          "capacity": {
            "format": "int64",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "game_key": {
            "type": "string"
          },
          "game_settings": {},
          "host_player_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "join_code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "round": {
            "format": "int64",
            "type": "integer"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "game_key",
          "name",
          "join_code",
          "capacity",
          "phase",
          "round",
          "version",
          "host_player_id",
          "created_at",
          "game_settings"
        ],
        "type": "object"
      },
      "Member": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "disconnected_until": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "generation": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "join_sequence": {
            "format": "int64",
            "type": "integer"
          },
          "joined_at": {
            "format": "date-time",
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "member_settings": {},
          "player_id": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "seat_settings": {},
          "team_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "player_id",
          "display_name",
          "generation",
          "active",
          "team_id",
          "ready",
          "joined_at",
          "join_sequence",
          "disconnected_until",
          "kind",
          "seat_settings",
          "member_settings"
        ],
        "type": "object"
      },
      "Snapshot": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/Snapshot.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "lobby": {
            "$ref": "#/components/schemas/Lobby"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/Member"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "membership_generation": {
            "format": "int64",
            "type": "integer"
          },
          "start_roster": {
            "items": {
              "$ref": "#/components/schemas/StartRosterEntry"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "start_rules": {
            "$ref": "#/components/schemas/StartRules"
          },
          "teams": {
            "items": {
              "$ref": "#/components/schemas/Team"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "watcher_count": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "lobby",
          "teams",
          "members",
          "start_roster",
          "membership_generation",
          "channel",
          "start_rules",
          "watcher_count"
        ],
        "type": "object"
      },
      "StartRosterEntry": {
        "additionalProperties": false,
        "properties": {
          "member_id": {
            "type": "string"
          },
          "player_id": {
            "type": "string"
          },
          "team_id": {
            "type": "string"
          },
          "team_order": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "player_id",
          "team_id",
          "member_id",
          "team_order"
        ],
        "type": "object"
      },
      "StartRules": {
        "additionalProperties": false,
        "properties": {
          "every_team_needs_member": {
            "type": "boolean"
          }
        },
        "required": [
          "every_team_needs_member"
        ],
        "type": "object"
      },
      "Team": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "lobby_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "order": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "lobby_id",
          "name",
          "order"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "LobbySignature": {
        "description": "t=\u003cunix seconds\u003e,v1=\u003chex HMAC-SHA256 of t + \".\" + method + \" \" + path + \".\" + body\u003e, keyed with the game's shared secret. A time more than 5 minutes from the lobby's clock, either way, is refused.",
        "in": "header",
        "name": "Lobby-Signature",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Generic Lobby Game API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/lobby/v1/game-api/games/{game_key}/lobbies/{lobby_id}": {
      "get": {
        "description": "Returns a lobby of the game as the game sees it: the snapshot of the player API, with every member and no player behind it, so membership_generation is 0. A lobby that is gone, or isn't the game's, is not_found. It reads without waiting for requests that change the lobby, so a game can call it while one of its hooks runs.",
        "operationId": "getGameLobby",
        "parameters": [
          {
            "description": "The game's key: the one whose secret signed the request.",
            "in": "path",
            "name": "game_key",
            "required": true,
            "schema": {
              "description": "The game's key: the one whose secret signed the request.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "lobby_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/GameProblem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/GameProblem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/GameProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/GameProblem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/GameProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "LobbySignature": []
          }
        ],
        "summary": "Read a lobby of the game",
        "tags": [
          "Game API"
        ]
      }
    },
    "/lobby/v1/game-api/games/{game_key}/lobbies/{lobby_id}/authorize-watch": {
      "post": {
        "description": "Answers 204 when player_id may watch the lobby, for the game's watcher reads: an active member, or a watcher the host hasn't kicked. Anyone else is refused with 403: watcher_kicked for a watcher the host kicked, and permission_denied for everyone else and for a lobby that is gone.",
        "operationId": "authorizeGameWatch",
        "parameters": [
          {
            "description": "The game's key: the one whose secret signed the request.",
            "in": "path",
            "name": "game_key",
            "required": true,
            "schema": {
              "description": "The game's key: the one whose secret signed the request.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "lobby_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeWatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/GameProblem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/GameProblem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/GameProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/GameProblem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/GameProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "LobbySignature": []
          }
        ],
        "summary": "Check that a player may watch a lobby",
        "tags": [
          "Game API"
        ]
      }
    }
  }
}
