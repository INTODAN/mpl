# {{ ansible_managed }}
# Written by `scripts/vm.sh deploy`: the lobby Lambda's settings
# (README.md, "Running the lobby"), which Terraform passes to the function
# (deploy/terraform/lambda.tf). Contains secrets: keep it in deploy/local/,
# never commit it.
#
# The database URL uses sslmode=require: encrypted, but the server certificate
# isn't checked. To check it, ship deploy/local/secrets/postgres-tls/server.crt
# with the Lambda and use sslmode=verify-full&sslrootcert=<path to it>.
LOBBY_DATABASE_URL=postgres://{{ lobby_app_role }}:{{ lobby_app_password }}@{{ vm_hostname }}:{{ app_postgres_published_port }}/{{ lobby_database }}?sslmode=require
LOBBY_PUBLIC_URL={{ app_lobby_origin }}
LOBBY_CENTRIFUGO_PUBLIC_URL=wss://{{ vm_hostname }}/connection/websocket
LOBBY_CENTRIFUGO_API_URL=https://{{ vm_hostname }}/api
LOBBY_CENTRIFUGO_API_KEY={{ centrifugo_api_key }}
LOBBY_CONNECTION_TOKEN_HMAC_SECRET={{ connection_token_hmac_secret }}
LOBBY_PROXY_SECRET={{ lobby_proxy_secret }}
LOBBY_PLAYER_TOKEN_KEYS={{ lobby_player_token_keys }}
LOBBY_ALLOWED_ORIGINS={{ app_tenant_origins | join(',') }}
LOBBY_GAMES={{ tenants | map(attribute='lobby_game') | list | to_json(separators=[',', ':']) }}
{% for tenant in tenants %}
{{ app_game_secret_env_prefix ~ (tenant.key | upper | replace('-', '_')) }}={{ lookup('ansible.builtin.password', app_tenant_secrets_dir ~ '/' ~ tenant.key ~ '/game_secret', length=64, chars=['ascii_letters', 'digits']) }}
{% endfor %}
