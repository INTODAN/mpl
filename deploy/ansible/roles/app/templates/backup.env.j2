# {{ ansible_managed }}
# Settings for mpl-backup (deploy/README.md, "Backups"), with the upload-only
# AWS key from deploy/local/secrets/database_backups.json.
MPL_BACKUP_APP_DIR={{ vm_app_dir }}
# Every database: the lobby's and each tenant's.
MPL_BACKUP_DATABASES={{ app_databases | map(attribute='database') | join(' ') }}
MPL_BACKUP_MOVED_AWAY_MARKER={{ app_moved_away_marker }}
MPL_BACKUP_BUCKET={{ app_database_backups.bucket }}
MPL_BACKUP_PREFIX={{ app_database_backups.prefix }}
MPL_BACKUP_REGION={{ app_database_backups.region }}
MPL_BACKUP_METRIC_NAMESPACE={{ app_database_backups.metric_namespace }}
MPL_BACKUP_METRIC_NAME={{ app_database_backups.metric_name }}
AWS_ACCESS_KEY_ID={{ app_database_backups.access_key_id }}
AWS_SECRET_ACCESS_KEY={{ app_database_backups.secret_access_key }}
