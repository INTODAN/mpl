# {{ ansible_managed }}
# Written by `scripts/vm.sh deploy` for the tenant {{ tenant.key }}: what the
# game needs from the lobby and the VM (deploy/README.md, "Tenants"). The
# deploy publishes it to the deploy bucket, under mpl/tenants/{{ tenant.key }}/,
# where the game's own deploy reads it. Contains secrets: never commit it.
#
# Its database on the VM, with the role that owns it, over TLS.
DATABASE_URL=postgres://{{ tenant.role }}:{{ app_tenant_password }}@{{ vm_hostname }}:{{ app_postgres_published_port }}/{{ tenant.database }}?sslmode=require
DATABASE_HOST={{ vm_hostname }}
DATABASE_PORT={{ app_postgres_published_port }}
DATABASE_NAME={{ tenant.database }}
DATABASE_ROLE={{ tenant.role }}
DATABASE_PASSWORD={{ app_tenant_password }}
# The lobby: its URL, the game's key in it, and the shared secret that signs
# the lobby's hook calls and the game's game API calls.
LOBBY_URL={{ app_lobby_origin }}
LOBBY_GAME_KEY={{ tenant.key }}
LOBBY_GAME_SECRET={{ lookup('ansible.builtin.password', app_tenant_secrets_dir ~ '/' ~ tenant.key ~ '/game_secret', length=64, chars=['ascii_letters', 'digits']) }}
# Centrifugo: games publish with its API key.
CENTRIFUGO_API_URL=https://{{ vm_hostname }}/api
CENTRIFUGO_API_KEY={{ centrifugo_api_key }}
CENTRIFUGO_PUBLIC_URL=wss://{{ vm_hostname }}/connection/websocket
