#!/usr/bin/python3
"""Back the databases up to S3: dump each in the db container and upload the dumps.

The databases are the lobby's own and each tenant's, named in
MPL_BACKUP_DATABASES, separated by spaces. The mpl-backup timer runs this
every day, and the VM deploy runs it once (deploy/README.md, "Backups").
systemd passes its settings in the environment, from
/etc/mpl-backup/backup.env, which only root can read.

The AWS key can only upload under the bucket's prefix and publish the backup
metric. It can't list, read or delete earlier backups, and S3's lifecycle
rules expire them. Each successful backup adds 1 to the metric; an alarm emails
when none did for 26 hours. A run counts only when no database failed.

A VM that a move left behind (its moved-away marker exists) is skipped, and so
is a database without tables yet, without failing; a run that backed nothing
up counts no backup. Each dump is the same as `scripts/vm.sh dump` makes, so
`scripts/vm.sh restore` takes it as it is.
"""

import datetime
import os
import subprocess
import sys

SETTINGS = (
    "MPL_BACKUP_APP_DIR",
    "MPL_BACKUP_DATABASES",
    "MPL_BACKUP_MOVED_AWAY_MARKER",
    "MPL_BACKUP_BUCKET",
    "MPL_BACKUP_PREFIX",
    "MPL_BACKUP_REGION",
    "MPL_BACKUP_METRIC_NAMESPACE",
    "MPL_BACKUP_METRIC_NAME",
)
DB_EXEC = ["docker", "compose", "exec", "-T", "db"]


def log(message):
    print(message, flush=True)


def aws_clients(region):
    """Return (s3, cloudwatch). boto3 reads the key from the environment."""
    import boto3  # Ubuntu's python3-boto3, installed by the VM deploy.

    session = boto3.session.Session(region_name=region)
    return session.client("s3"), session.client("cloudwatch")


def table_count(run, app_dir, database):
    result = run(
        DB_EXEC + ["psql", "--no-psqlrc", "--username", "postgres", "--dbname", database,
                   "--tuples-only", "--no-align", "--command",
                   "SELECT count(*) FROM pg_tables WHERE schemaname NOT IN ('pg_catalog', 'information_schema')"],
        cwd=app_dir, check=True, capture_output=True, text=True,
    )
    return int(result.stdout.strip())


def main(environ=None, run=subprocess.run, clients=aws_clients, now=None):
    environ = os.environ if environ is None else environ
    missing = [name for name in SETTINGS if not environ.get(name)]
    if missing:
        log(f"Missing settings: {', '.join(missing)}. Run the VM deploy again (deploy/README.md).")
        return 1
    app_dir = environ["MPL_BACKUP_APP_DIR"]

    if os.path.exists(environ["MPL_BACKUP_MOVED_AWAY_MARKER"]):
        log("Skipped: this VM was moved away from, so its databases are no longer the live ones.")
        return 0

    now = now or datetime.datetime.now(datetime.timezone.utc)
    backed_up, failed = 0, False
    for database in environ["MPL_BACKUP_DATABASES"].split():
        result = back_up(environ, run, clients, now, app_dir, database)
        if result is None:
            failed = True
        elif result:
            backed_up += 1
    if failed:
        return 1
    if backed_up == 0:
        return 0

    _, cloudwatch = clients(environ["MPL_BACKUP_REGION"])
    try:
        cloudwatch.put_metric_data(
            Namespace=environ["MPL_BACKUP_METRIC_NAMESPACE"],
            MetricData=[{"MetricName": environ["MPL_BACKUP_METRIC_NAME"], "Value": 1, "Unit": "Count"}],
        )
    except Exception as error:  # noqa: BLE001
        log(f"The backup is in S3, but counting it failed, so the backup alarm may email: {error}")
        return 1
    return 0


def back_up(environ, run, clients, now, app_dir, database):
    """Dump one database and upload it. True when backed up, False when skipped, None when failed."""
    try:
        tables = table_count(run, app_dir, database)
    except (subprocess.CalledProcessError, ValueError) as error:
        log(f"Couldn't count {database}'s tables, so it wasn't backed up: {error}")
        return None
    if tables == 0:
        log(f"Skipped: {database} has no tables yet.")
        return False

    name = f"{database}-{now.strftime('%Y%m%dT%H%M%SZ')}.dump"
    key = environ["MPL_BACKUP_PREFIX"] + name
    bucket = environ["MPL_BACKUP_BUCKET"]
    # The dumps directory is the db container's /dumps, and only root can read it.
    path = os.path.join(app_dir, "dumps", name)
    try:
        # Custom format is compressed and is what the restore expects.
        run(DB_EXEC + ["pg_dump", "--username", "postgres", "--dbname", database,
                       "--format", "custom", "--no-owner", "--no-privileges", "--file", f"/dumps/{name}"],
            cwd=app_dir, check=True)
        size = os.path.getsize(path)
        s3, _ = clients(environ["MPL_BACKUP_REGION"])
        with open(path, "rb") as dump:
            s3.put_object(Bucket=bucket, Key=key, Body=dump, ContentType="application/octet-stream")
    except subprocess.CalledProcessError as error:
        log(f"pg_dump failed, so {database} wasn't backed up: {error}")
        return None
    except Exception as error:  # noqa: BLE001 - boto3's errors share no narrower base.
        log(f"The backup of {database} didn't reach s3://{bucket}/{key}: {error}")
        return None
    finally:
        if os.path.exists(path):
            os.remove(path)
    log(f"Backed up {database} to s3://{bucket}/{key} ({size} bytes).")
    return True


if __name__ == "__main__":
    sys.exit(main())
